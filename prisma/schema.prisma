generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String     
  name      String
  cards     Card[]
  movements Movement[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Card {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer    String   // "MASTERCARD" | "VISA"
  balance   Float
  lastFour  String
  expiry    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Movement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   // Ej: "Adobe", "Juan Cabrera"
  description String   // Ej: "Pago de suscripción", "Pago recibido"
  amount      Float
  type        String   // "SUS" | "CASH_IN" | "CASH_OUT"
  createdAt   DateTime @default(now())
}
